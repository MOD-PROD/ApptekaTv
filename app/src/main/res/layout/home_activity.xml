<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay"
        app:liftOnScrollTargetViewId="@id/recycler">

        <!-- ATV (Gonzo 25/11) : en-tête du Store, « App Store - <appareil actif> ». -->
        <TextView
            android:id="@+id/store_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"
            tools:text="App Store - Galaxy S21"
            tools:visibility="visible" />

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:popupTheme="@style/AppTheme.PopupOverlay">

            <!-- ATV (Gonzo 25/11) : barre du Store = 6 icônes réparties sur toute la largeur. -->
            <LinearLayout
                android:id="@+id/store_icon_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/demo_tv_target"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    app:tint="?attr/colorOnSurface" />
                <ImageButton
                    android:id="@+id/store_bar_files"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/nav_tv_files"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_bar_files"
                    app:tint="?attr/colorOnSurface" />
                <ImageButton
                    android:id="@+id/store_bar_distro"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/nav_downloaded"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_bar_downloaded"
                    app:tint="?attr/colorOnSurface" />
                <ImageButton
                    android:id="@+id/store_bar_installed"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/nav_installed"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_bar_installed"
                    app:tint="?attr/colorOnSurface" />
                <ImageButton
                    android:id="@+id/store_bar_settings"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/nav_settings"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_bar_settings"
                    app:tint="?attr/colorOnSurface" />
                <ImageButton
                    android:id="@+id/store_bar_search"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu_search"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_bar_search"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <HorizontalScrollView
            android:id="@+id/store_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingBottom="4dp"
            android:scrollbars="none"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filter_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_category"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/all_categories"
                    app:chipIcon="@drawable/ic_category"
                    app:chipIconTint="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_open_source"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/open_source_short" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_exclusive"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/exclusive_short" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_content_filter"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:chipIcon="@drawable/ic_content_filter"
                    app:chipIconTint="?attr/colorOnSurfaceVariant"
                    tools:text="Hidden: 18+"
                    tools:visibility="visible" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <include
            android:id="@+id/update_block"
            layout="@layout/update_block"
            android:visibility="gone"
            tools:visibility="visible" />

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/frame"
        android:background="?attr/toolbar_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_upload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="96dp"
        android:src="@drawable/ic_cloud_upload"
        app:elevation="3dp"
        app:fabSize="normal"
        app:pressedTranslationZ="6dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_post"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="96dp"
        android:src="@drawable/ic_pencil"
        app:elevation="3dp"
        app:fabSize="normal"
        app:pressedTranslationZ="6dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_create_chat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="96dp"
        android:contentDescription="@string/create_chat_title"
        android:src="@drawable/ic_baseline_add_24"
        app:elevation="3dp"
        app:fabSize="normal"
        app:pressedTranslationZ="6dp" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:minHeight="44dp"
        app:itemPaddingBottom="10dp"
        app:itemPaddingTop="10dp"
        app:labelVisibilityMode="unlabeled"
        app:menu="@menu/bottom_navigation_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
